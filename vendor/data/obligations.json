    { "id": "obl.kid.school", "agent": "agent.kid", "activity": "act.school", "window": ["morning", "midday"],
      "lateness_window": 10, "consequence": { "need": "need.duty", "amount": 15 } },
    { "id": "obl.neighbour.errand", "agent": "agent.neighbour", "activity": "act.errand", "window": ["midday"],
