      "gated_by_tags": ["paw_tag"], "gated_by_attrs": ["attr.thumbless_paw", "attr.canine_claws"], "gated_by_capacity": { "key": "manipulation", "below": 500 } },
    { "id": "obl.coworker.work", "agent": "agent.coworker", "activity": "act.work", "window": ["morning", "midday", "afternoon"],
