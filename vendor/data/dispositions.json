    "wary": { "weights": { "react.avian_wings": 3, "react.insect_chitin": 2, "react.legless": 2 }, "precision": 0.25 },
    "devoted": { "weights": { "react.watched": 3, "react.tail": 2, "react.canid": 2 }, "precision": 0.15 },
